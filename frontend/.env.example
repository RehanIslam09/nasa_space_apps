# Earth Song — Frontend Environment Configuration
# Copy this file to .env.local for local development.

# ---------------------------------------------------------------------------
# Public Client Variables (Exposed to Browser)
# ---------------------------------------------------------------------------
# Supabase project URL (must be valid HTTPS URL)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase public anonymous or publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# ---------------------------------------------------------------------------
# Server-Only Configuration (Never Exposed to Browser)
# ---------------------------------------------------------------------------
# PRANA Python FastAPI Backend URL for Next.js BFF API proxy routes
FASTAPI_BACKEND_URL="http://localhost:8000"

# Optional PostgreSQL Connection Pooler (Supabase port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Optional Direct PostgreSQL Migrations (Supabase port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# Optional Supabase Service Role Key (Keep secret)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
