# ==============================================================================
# NASA Space Apps — Frontend .gitignore (Next.js Application)
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
.next/
out/

# Production build artifacts
build/
dist/

# Environment variables & local secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Testing & Coverage
coverage/
.vitest/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS and Editor metadata
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript & Next.js auto-generated type declarations
*.tsbuildinfo
next-env.d.ts

