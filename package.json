{
  "name": "nasa-experience-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @nasa-experience/frontend dev",
    "build": "pnpm --filter @nasa-experience/frontend build",
    "start": "pnpm --filter @nasa-experience/frontend start",
    "test": "pnpm -r test",
    "test:frontend": "pnpm --filter @nasa-experience/frontend test",
    "test:backend": "pnpm --filter @nasa-experience/backend test",
    "test:contract": "pnpm --filter @nasa-experience/contracts test",
    "test:all": "pnpm -r test",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm --filter @nasa-experience/frontend lint",
    "boundary:check": "pnpm --filter @nasa-experience/frontend lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:verify": "pnpm --filter @nasa-experience/backend db:verify",
    "db:generate": "pnpm --filter @nasa-experience/backend db:generate",
    "db:migrate": "pnpm --filter @nasa-experience/backend db:migrate",
    "db:studio": "pnpm --filter @nasa-experience/backend db:studio"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.7.3"
  }
}
