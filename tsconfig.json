{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "paths": {
      "@nasa-experience/contracts": ["./packages/contracts/src"],
      "@nasa-experience/backend": ["./backend/src"],
      "@nasa-experience/frontend/*": ["./frontend/src/*"]
    }
  },
  "include": ["packages/contracts/src/**/*", "backend/**/*.ts", "frontend/src/**/*"],
  "exclude": ["node_modules", "frontend/.next"]
}
