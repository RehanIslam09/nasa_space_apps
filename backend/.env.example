# PRANA — The Living Breath of Earth: Backend Environment Configuration
# Copy this file to .env inside backend/ directory for local development.

PROJECT_NAME="PRANA — The Living Breath of Earth"
VERSION="1.0.0"
API_PREFIX="/api"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Audio DSP Synthesis Configuration
DEFAULT_SAMPLE_RATE=44100
DEFAULT_AUDIO_DURATION=10.0
MAX_AUDIO_DURATION=60.0

# NASA Scientific Visualization Studio (SVS) APIs
NASA_SVS_API_BASE="https://svs.gsfc.nasa.gov/api"
NASA_TIMEOUT_SECONDS=30

# CORS Allowed Origins (Comma-separated list or JSON array)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
